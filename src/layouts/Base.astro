---
import "@fontsource/open-sans/400.css";
import "@fontsource/open-sans/400-italic.css";
import "@fontsource/open-sans/700.css";
import "@fontsource/halant/300.css";
import "../styles/global.css";
import IconSprite from "../components/IconSprite.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  /** added to <body>; also enables the per-page CSS variants */
  bodyClass?: string;
  /** canonical path, e.g. "/jamesclow/" */
  path?: string;
  /** filename of the social card image in /og/, e.g. "jamesclow.jpg" */
  ogImage?: string;
}

const {
  title,
  description,
  bodyClass = "",
  path = "/",
  ogImage = "belfast-city-hall.jpg",
} = Astro.props;
const canonical = `https://bt1apartments.co.uk${path}`;
const ogImageUrl = `https://bt1apartments.co.uk/og/${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />

    <title>{title}</title>
    <meta content={description} name="description" />

    <link href={canonical} rel="canonical" />

    <link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
    <link href="/favicon-16x16.png" rel="icon" sizes="16x16" type="image/png" />
    <link href="/manifest.json" rel="manifest" />
    <link color="#4B6A90" href="/safari-pinned-tab.svg" rel="mask-icon" />
    <meta content="#4b6a90" name="msapplication-TileColor" />
    <meta content="/mstile-144x144.png" name="msapplication-TileImage" />
    <meta content="#ffffff" name="theme-color" />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content="@bt1apartments" name="twitter:site" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={ogImageUrl} name="twitter:image" />

    <meta content={ogImageUrl} property="og:image" />
    <meta content={canonical} property="og:url" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content="BT1 Apartments" property="og:site_name" />
  </head>

  <body class={bodyClass}>
    <main>
      <IconSprite />
      <SiteHeader />
      <slot />
      <SiteFooter />
    </main>
  </body>
</html>
